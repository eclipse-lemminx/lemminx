{
  "scopeName": "source.test",
  "name": "Test Language",
  "patterns": [
    { "include": "#comments" },
    { "include": "#strings" },
    { "include": "#keywords" },
    { "include": "#numbers" },
    { "include": "#functions" }
  ],
  "repository": {
    "comments": {
      "match": "//.*$",
      "name": "comment.line.double-slash.test"
    },
    "strings": {
      "begin": "\"",
      "end": "\"",
      "name": "string.quoted.double.test",
      "patterns": [
        {
          "match": "\\\\.",
          "name": "constant.character.escape.test"
        }
      ]
    },
    "keywords": {
      "match": "\\b(if|else|return|def|while|for|class)\\b",
      "name": "keyword.control.test"
    },
    "numbers": {
      "match": "\\b[0-9]+(\\.[0-9]+)?\\b",
      "name": "constant.numeric.test"
    },
    "functions": {
      "match": "\\b([a-zA-Z_][a-zA-Z0-9_]*)\\s*(?=\\()",
      "captures": {
        "1": { "name": "entity.name.function.test" }
      }
    }
  }
}
